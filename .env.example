# =============================================================================
# Environment variables — copy to `.env.local` and fill in values.
# Never commit `.env.local` or any file containing real secrets.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Appointment SaaS"

# Default locale (Hebrew-first). Used for UI direction and future i18n.
NEXT_PUBLIC_DEFAULT_LOCALE=he

# Multi-tenant: subdomain routing (e.g. tenant.app.example.com)
# Set to your production root domain when deploying.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Demo mode ---------------------------------------------------------------
# When true, the app runs against in-memory fixtures and DOES NOT need a
# Supabase project to be configured. The login screen shows three demo role
# buttons (Super Admin, Business Owner, Staff). Set to "false" (or unset) in
# production deployments.
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (public — safe for browser, RLS must protect data) -------------
# Required only when NEXT_PUBLIC_DEMO_MODE is "false".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — NEVER prefix with NEXT_PUBLIC_) -----------------
# Service role bypasses RLS. Use only in Server Components, Route Handlers,
# and Server Actions. Never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth / session (server-only) --------------------------------------------
# Used to sign session cookies and encrypt sensitive server payloads.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Demo phone+password credentials (server-only) ---------------------------
# When set together with NEXT_PUBLIC_DEMO_MODE=true, the /login screen renders
# a phone+password form. Used ONLY for local demo — never wire to production
# data. Set throwaway, non-identifying values for safety.
DEMO_SUPER_ADMIN_PHONE=
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_BUSINESS_OWNER_PHONE=
DEMO_BUSINESS_OWNER_PASSWORD=
DEMO_STAFF_PHONE=
DEMO_STAFF_PASSWORD=

# --- Optional: skip strict env validation (CI scaffold builds only) ----------
# SKIP_ENV_VALIDATION=true
