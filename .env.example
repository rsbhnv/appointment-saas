# =============================================================================
# Environment variables — copy to `.env.local` and fill in values.
# Never commit `.env.local` or any file containing real secrets.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Appointment SaaS"
NEXT_PUBLIC_DEFAULT_LOCALE=he
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Demo mode ---------------------------------------------------------------
# true  = in-memory fixtures, no Supabase required (local UI / previews)
# false = production path — requires Supabase keys below
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (public — safe for browser; RLS protects data) -----------------
# Project URL example: https://gufxjymouqzfkfsqwmnz.supabase.co
# Dashboard → Project Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — NEVER prefix with NEXT_PUBLIC_) -----------------
# Dashboard → Project Settings → API → service_role secret (server only)
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth / session (server-only) --------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Demo phone+password (server-only, optional) -----------------------------
DEMO_SUPER_ADMIN_PHONE=
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_BUSINESS_OWNER_PHONE=
DEMO_BUSINESS_OWNER_PASSWORD=
DEMO_STAFF_PHONE=
DEMO_STAFF_PASSWORD=

# --- Optional: skip strict env validation (CI scaffold builds only) ------------
# SKIP_ENV_VALIDATION=true
